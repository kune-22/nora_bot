# Discord Bot
TOKEN=your_bot_token

# Discord OAuth2 (Developer Portal > OAuth2 > General)
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_application_client_secret
DISCORD_REDIRECT_URI=http://localhost:3022/api/auth/callback

# Dashboard session/API
DASHBOARD_URL=http://localhost:3022
DASHBOARD_SESSION_SECRET=replace-with-a-long-random-secret
API_PORT=8000
